# Chép tệp này thành .env rồi điền giá trị thật. Không đưa .env lên GitHub.

# Mật khẩu vào trang /nhan-vien. Bắt buộc phải đặt thì mới đăng nhập được.
ADMIN_PASSWORD=

# Chuỗi bí mật để ký phiên đăng nhập. Đặt một chuỗi dài, ngẫu nhiên.
SECRET_KEY=

# Để trống thì dữ liệu lưu vào thư mục du-lieu/ trên máy (SQLite).
# Khi đưa lên mạng, dán chuỗi kết nối PostgreSQL của Neon vào đây.
DATABASE_URL=

# Thời hạn phản hồi hiện cho khách, và link Zalo ở chân trang (có thể để trống).
REPLY_WITHIN=một ngày làm việc
ZALO_LINK=

# Bật cả hai dòng dưới khi chạy trên mạng (Render).
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Số liên hệ công khai của studio, hiển thị trên trang và trang chính sách.
STUDIO_CONTACT=0941761768
